<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Description>
			A powerful Cron-based Scheduler for .NET Core applications, optimized for Kubernetes/Docker and Windows Services.
			A lightweight alternative to Quartz Scheduler and HangFire.
		</Description>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="Cronos" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Bet.Extensions.Options" />
		<!-- Direct pins lifting stale transitives (parent: Bet.Extensions.Options / netstandard2.0 BCL); versions in build/dependencies.props -->
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Threading.Channels" />
		<PackageReference Include="Microsoft.NETCore.Platforms" />
	</ItemGroup>
</Project>
