<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Description>
			A powerful Cron-based Scheduler for .NET Core applications, optimized for Kubernetes/Docker and Windows Services.
			A lightweight alternative to Quartz Scheduler and HangFire.
		</Description>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="Cronos" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageReference Include="Bet.Extensions.Options" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
	</ItemGroup>
</Project>
